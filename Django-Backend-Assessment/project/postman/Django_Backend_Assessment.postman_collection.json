    {
      "name": "GET Items",
      "item": [
        {
          "name": "Get All Items",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/items/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const fields = [\"id\", \"name\", \"description\", \"category\", \"brand\", \"price\", \"discount_percentage\", \"stock_quantity\", \"rating\", \"is_available\", \"created_at\", \"updated_at\"];",
                  "function checkItems(items) {",
                  "    pm.expect(items).to.be.an(\"array\");",
                  "    items.forEach(item => {",
                  "        pm.expect(item).to.include.all.keys(fields);",
                  "        pm.expect(item.price).to.be.a(\"number\");",
                  "        pm.expect(item.rating).to.be.a(\"number\");",
                  "        pm.expect(item.is_available).to.be.a(\"boolean\");",
                  "    });",
                  "}",
                  "pm.test(\"Item fields, count and order\", () => {",
                  "    const items = pm.response.json();",
                  "    checkItems(items);",
                  "    pm.expect(items).to.have.lengthOf(20);",
                  "    pm.expect(items[0].id).to.equal(1);",
                  "});"
                ]
              }
            }
          ]
        },
