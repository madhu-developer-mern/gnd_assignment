{
  "info": {
    "name": "Django Backend Assessment",
    "description": "Local requests and assertions for registration and the supplied 20-product catalog.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "registration_email",
      "value": "madhu@example.com"
    },
    {
      "key": "registration_phone",
      "value": "9876543210"
    }
  ],
  "item": [
    {
      "name": "Registration",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \" Madhu \",\n  \"email\": \"{{registration_email}}\",\n  \"phone_number\": \"{{registration_phone}}\",\n  \"password\": \"Password@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/register/"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = pm.variables.replaceIn(\"{{$guid}}\");",
                  "const phone = String(Math.floor(Math.random() * 10000000000)).padStart(10, \"0\");",
                  "pm.collectionVariables.set(\"registration_email\", \"madhu+\" + runId + \"@example.com\");",
                  "pm.collectionVariables.set(\"registration_phone\", phone);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Registration response is normalized and contains no password\", () => {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.all.keys([\"id\", \"name\", \"email\", \"phone_number\", \"message\"]);",
                  "    pm.expect(data.id).to.be.a(\"number\");",
                  "    pm.expect(data.name).to.equal(\"Madhu\");",
                  "    pm.expect(data.email).to.equal(pm.collectionVariables.get(\"registration_email\"));",
                  "    pm.expect(data.phone_number).to.equal(pm.collectionVariables.get(\"registration_phone\"));",
                  "    pm.expect(data.message).to.equal(\"User registered successfully\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \" Madhu \",\n  \"email\": \"invalid-email\",\n  \"phone_number\": \"{{registration_phone}}\",\n  \"password\": \"Password@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/register/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Validation errors\", () => {",
                  "    const data = pm.response.json();",
                  "    [\"email\"].forEach(field => pm.expect(data[field]).to.be.an(\"array\").and.not.empty);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid Phone",
